<mjml>
  <mj-head>
    <mj-title>Votre compte CarbonTrack est prêt</mj-title>
    <mj-preview>{{preview}}</mj-preview>
    <mj-breakpoint width="520px" />
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="24px" color="#57534e" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-button
        background-color="#15803d"
        color="#ffffff"
        font-size="15px"
        font-weight="600"
        border-radius="8px"
        inner-padding="13px 24px"
        padding="0"
      />
      <mj-divider border-width="1px" border-color="#e7e5e4" padding="0" />
    </mj-attributes>
    <mj-style>
      .surtitre div { letter-spacing: .07em; text-transform: uppercase; }
      .titre div { letter-spacing: -.02em; }
      a { color: #15803d; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#fafaf9" width="600px">
    <mj-section padding="36px 24px 0">
      <mj-column>
        <mj-table padding="0" cellpadding="0" cellspacing="0">
          <tr>
            <td width="36" style="padding:0;line-height:0">
              <img
                src="{{siteUrl}}/email-logo.png"
                width="36"
                height="36"
                alt=""
                style="display:block;border:0;outline:none;text-decoration:none"
              />
            </td>
            <td style="padding:0 0 0 12px;font-size:17px;font-weight:700;color:#1c1917;letter-spacing:-.01em">
              CarbonTrack
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 24px 0">
      <mj-column background-color="#ffffff" border="1px solid #e7e5e4" border-radius="14px" padding="36px 32px">
        <mj-text css-class="surtitre" font-size="12px" line-height="18px" font-weight="600" color="#15803d" padding="0 0 12px">Bienvenue</mj-text>

        <mj-text css-class="titre" font-size="24px" line-height="32px" font-weight="700" color="#1c1917" padding="0 0 18px">
          Votre compte est prêt,<br />{{name}}
        </mj-text>

        <mj-text padding="0 0 28px">
          Composez un projet, ajoutez-y vos matériaux et leurs quantités : l'empreinte se calcule
          pendant la saisie, et s'affiche poste par poste.
        </mj-text>

        <mj-button href="{{siteUrl}}/projects/create" align="left" padding="0 0 32px">
          Créer mon premier projet
        </mj-button>

        <mj-divider padding="0 0 24px" />

        <mj-text css-class="surtitre" font-size="12px" line-height="18px" font-weight="600" color="#15803d" padding="0 0 16px">Un ordre de grandeur</mj-text>

        <mj-table padding="0 0 14px" cellpadding="0" cellspacing="0" font-size="14px">
          <tr>
            <td style="padding:0 0 10px;color:#57534e">Polyuréthane projeté</td>
            <td style="padding:0 0 10px;width:90px" align="right">
              <span style="color:#b91c1c;font-weight:600">34,2</span>
              <span style="color:#a8a29e"> kg/m²</span>
            </td>
          </tr>
          <tr>
            <td style="padding:10px 0;border-top:1px solid #f5f5f4;color:#57534e">Laine de bois</td>
            <td style="padding:10px 0;border-top:1px solid #f5f5f4" align="right">
              <span style="color:#b45309;font-weight:600">12,4</span>
              <span style="color:#a8a29e"> kg/m²</span>
            </td>
          </tr>
          <tr>
            <td style="padding:10px 0 0;border-top:1px solid #f5f5f4;color:#57534e">Ouate de cellulose</td>
            <td style="padding:10px 0 0;border-top:1px solid #f5f5f4" align="right">
              <span style="color:#15803d;font-weight:600">4,8</span>
              <span style="color:#a8a29e"> kg/m²</span>
            </td>
          </tr>
        </mj-table>

        <mj-text css-class="discret" font-size="13px" line-height="20px" color="#a8a29e" padding="0">
          Trois isolants, la même résistance thermique, un rapport de 1 à 7 sur le carbone. C'est
          ce genre d'écart que CarbonTrack met sous les yeux.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 24px 44px">
      <mj-column>
        <mj-text css-class="discret" font-size="13px" line-height="20px" color="#a8a29e" align="center" padding="0">
          CarbonTrack · empreinte carbone des matériaux de construction
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
