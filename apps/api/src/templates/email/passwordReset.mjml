<mjml>
  <mj-head>
    <mj-title>Réinitialisation de votre mot de passe</mj-title>
    <mj-preview>{{preview}}</mj-preview>
    <mj-breakpoint width="520px" />
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="24px" color="#57534e" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-button
        background-color="#15803d"
        color="#ffffff"
        font-size="15px"
        font-weight="600"
        border-radius="8px"
        inner-padding="13px 24px"
        padding="0"
      />
      <mj-divider border-width="1px" border-color="#e7e5e4" padding="0" />
    </mj-attributes>
    <mj-style>
      .surtitre div { letter-spacing: .07em; text-transform: uppercase; }
      .titre div { letter-spacing: -.02em; }
      a { color: #15803d; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#fafaf9" width="600px">
    <mj-section padding="36px 24px 0">
      <mj-column>
        <mj-table padding="0" cellpadding="0" cellspacing="0">
          <tr>
            <td width="36" style="padding:0;line-height:0">
              <img
                src="{{siteUrl}}/email-logo.png"
                width="36"
                height="36"
                alt=""
                style="display:block;border:0;outline:none;text-decoration:none"
              />
            </td>
            <td style="padding:0 0 0 12px;font-size:17px;font-weight:700;color:#1c1917;letter-spacing:-.01em">
              CarbonTrack
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 24px 0">
      <mj-column background-color="#ffffff" border="1px solid #e7e5e4" border-radius="14px" padding="36px 32px">
        <mj-text css-class="surtitre" font-size="12px" line-height="18px" font-weight="600" color="#15803d" padding="0 0 12px">Mot de passe</mj-text>

        <mj-text css-class="titre" font-size="26px" line-height="34px" font-weight="700" color="#1c1917" padding="0 0 18px">Réinitialisation demandée</mj-text>

        <mj-text padding="0 0 24px">
          Bonjour {{name}}, vous avez demandé à changer le mot de passe de votre compte
          CarbonTrack.
        </mj-text>

        <mj-button href="{{resetLink}}" align="left" padding="0 0 24px">
          Choisir un nouveau mot de passe
        </mj-button>

        <mj-table padding="0 0 28px" cellpadding="0" cellspacing="0">
          <tr>
            <td style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:14px 16px;font-size:14px;line-height:21px;color:#166534">
              Ce lien est valable <strong>une heure</strong> et ne fonctionne qu'une seule fois.
            </td>
          </tr>
        </mj-table>

        <mj-divider padding="0 0 20px" />

        <mj-text css-class="discret" font-size="13px" line-height="20px" color="#a8a29e" padding="0 0 10px">
          Le bouton ne fonctionne pas ? Copiez cette adresse dans votre navigateur :
        </mj-text>

        <mj-text padding="0 0 20px" font-size="12px" line-height="18px" color="#57534e">
          <span style="word-break:break-all">{{resetLink}}</span>
        </mj-text>

        <mj-text css-class="discret" font-size="13px" line-height="20px" color="#a8a29e" padding="0">
          Vous n'êtes pas à l'origine de cette demande ? Ignorez ce message : votre mot de passe
          actuel reste valable, et personne n'a accès à votre compte.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 24px 44px">
      <mj-column>
        <mj-text css-class="discret" font-size="13px" line-height="20px" color="#a8a29e" align="center" padding="0">
          CarbonTrack · empreinte carbone des matériaux de construction
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
