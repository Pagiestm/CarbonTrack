<mjml>
  <mj-head>
    <mj-title>Nouveau message de contact</mj-title>
    <mj-preview>{{preview}}</mj-preview>
    <mj-breakpoint width="520px" />
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="24px" color="#57534e" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-divider border-width="1px" border-color="#e7e5e4" padding="0" />
    </mj-attributes>
    <mj-style>
      .surtitre div { letter-spacing: .07em; text-transform: uppercase; }
      .titre div { letter-spacing: -.02em; }
      a { color: #15803d; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#fafaf9" width="600px">
    <mj-section padding="36px 24px 0">
      <mj-column>
        <mj-table padding="0" cellpadding="0" cellspacing="0">
          <tr>
            <td width="36" style="padding:0;line-height:0">
              <img
                src="{{siteUrl}}/email-logo.png"
                width="36"
                height="36"
                alt=""
                style="display:block;border:0;outline:none;text-decoration:none"
              />
            </td>
            <td style="padding:0 0 0 12px;font-size:17px;font-weight:700;color:#1c1917;letter-spacing:-.01em">
              CarbonTrack
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 24px 0">
      <mj-column background-color="#ffffff" border="1px solid #e7e5e4" border-radius="14px" padding="36px 32px">
        <mj-text css-class="surtitre" font-size="12px" line-height="18px" font-weight="600" color="#15803d" padding="0 0 12px">Formulaire de contact</mj-text>

        <mj-text css-class="titre" font-size="24px" line-height="32px" font-weight="700" color="#1c1917" padding="0 0 24px">{{subject}}</mj-text>

        <mj-table padding="0 0 24px" cellpadding="0" cellspacing="0">
          <tr>
            <td style="background:#fafaf9;border:1px solid #e7e5e4;border-radius:10px;padding:16px">
              <table cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td style="font-size:13px;color:#a8a29e;padding:0 0 4px">Expéditeur</td>
                </tr>
                <tr>
                  <td style="font-size:16px;font-weight:600;color:#1c1917;padding:0 0 6px">{{name}}</td>
                </tr>
                <tr>
                  <td style="font-size:14px;padding:0">
                    <a href="mailto:{{email}}" style="color:#15803d;text-decoration:none">{{email}}</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </mj-table>

        <mj-text css-class="surtitre" font-size="12px" line-height="18px" font-weight="600" color="#15803d" padding="0 0 12px">Message</mj-text>

        <mj-text padding="0 0 24px">{{message}}</mj-text>

        <mj-divider padding="0 0 20px" />

        <mj-text css-class="discret" font-size="13px" line-height="20px" color="#a8a29e" padding="0">
          Répondez directement à ce message : la réponse partira vers {{email}}.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 24px 44px">
      <mj-column>
        <mj-text css-class="discret" font-size="13px" line-height="20px" color="#a8a29e" align="center" padding="0">
          CarbonTrack · notification interne
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
