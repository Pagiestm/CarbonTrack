{
  "name": "@carbontrack/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.js",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.js",
    "build": "prisma generate",
    "start:prod": "prisma migrate deploy && node src/server.js",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local prisma/seed.js",
    "seed:reset": "node --env-file-if-exists=.env --env-file-if-exists=.env.local prisma/seed.js --reset",
    "seed:catalogue": "node --env-file-if-exists=.env --env-file-if-exists=.env.local prisma/seed.js --catalogue"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mjml": "^5.4.1",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
