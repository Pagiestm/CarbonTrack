# Copier en .env et renseigner. Le .env réel ne se commite pas.
# Un .env.local, s'il existe, l'emporte sur .env.

DATABASE_URL="postgresql://postgres:root@localhost:5432/CarbonTrack"
JWT_SECRET="une-chaine-longue-et-aleatoire"

NODE_ENV="development"
# Adresse du client : CORS, redirection après Google, liens des emails
FRONTEND_URL="http://localhost:5173"

# Emails (confirmation d'inscription, mot de passe oublié, contact)
EMAIL_USER="contact@example.com"
# Destinataire des messages du formulaire de contact (EMAIL_USER par défaut)
CONTACT_EMAIL=""
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""

# Connexion Google (console Google Cloud, identifiants OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"
