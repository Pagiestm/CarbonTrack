# Copier en .env et renseigner. Le .env réel ne se commite pas.

DATABASE_URL="postgresql://postgres:root@localhost:5432/CarbonTrack"
JWT_SECRET="une-chaine-longue-et-aleatoire"

NODE_ENV="development"
DEV_FRONTEND_URL="http://localhost:5173"
PROD_FRONTEND_URL="https://carbontrack.theotimepagies.com"

# Emails (confirmation d'inscription, mot de passe oublié, contact)
