# Copier en .env et renseigner. Le .env réel ne se commite pas.
# Un .env.local, s'il existe, l'emporte sur .env.
#
# Sert aussi aux piles Docker : compose.yaml y prend les secrets et impose ses
# propres DATABASE_URL et SMTP_* ; compose.prod.yaml y prend tout.

DATABASE_URL="postgresql://postgres:root@localhost:5432/CarbonTrack"
# 32 caractères minimum. Pour en générer un : openssl rand -base64 48
JWT_SECRET="remplacer-par-une-chaine-aleatoire-de-32-caracteres-minimum"

NODE_ENV="development"
# Adresse du client : CORS, redirection après Google, liens des emails
FRONTEND_URL="http://localhost:5173"

# Emails (confirmation d'inscription, mot de passe oublié, contact)
EMAIL_USER="contact@example.com"
# Destinataire des messages du formulaire de contact (EMAIL_USER par défaut)
CONTACT_EMAIL=""
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""

# Connexion Google (console Google Cloud, identifiants OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# --- compose.prod.yaml uniquement --------------------------------------------
# Identifiants du conteneur PostgreSQL. DATABASE_URL doit alors les reprendre
# et viser l'hôte `db` :
#   DATABASE_URL="postgresql://postgres:<POSTGRES_PASSWORD>@db:5432/CarbonTrack"
# En développement, compose.yaml ignore ces lignes : sa base est jetable.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="CarbonTrack"
